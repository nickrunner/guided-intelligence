---
const layers = [
  { name: 'AI Tests & Contract Invariants', desc: 'Unit, contract, migration, smoke. Run on every build.', color: '#7cc4ff', stage: 'Pre-review' },
  { name: 'Reviewer Semantic Gate', desc: 'Final human authority. Intent, invariants, domain coherence.', color: '#fbbf24', stage: 'Pre-merge' },
  { name: 'Ring Deployments', desc: 'Ring 0 (internal) → Ring 1 (limited real users) → general.', color: '#a78bfa', stage: 'Deploy' },
  { name: 'Feature Flags & Blast Radius', desc: 'Contain unknowns. Toggle without redeploy.', color: '#67e8f9', stage: 'Deploy' },
  { name: 'Monitoring & Observability', desc: 'Logs · metrics · traces · domain health checks.', color: '#a8e6cf', stage: 'Runtime' },
  { name: 'PAT Continuous Validation', desc: 'Async exploratory + regression on running system.', color: '#86efac', stage: 'Runtime' },
  { name: 'Severity Model (Sev1–5)', desc: 'Standardized response. Only Sev5 stops the line.', color: '#f87171', stage: 'Governance' },
];
---

<div class="card p-6 md:p-8">
  <div class="mb-6">
    <div class="eyebrow mb-1">Layered safety architecture</div>
    <div class="text-sm text-muted">Seven overlapping layers. No single layer has to be perfect; together they protect velocity.</div>
  </div>
  <ol class="space-y-2">
    {layers.map((l, i) => (
      <li class="grid grid-cols-[28px_1fr] gap-4 items-stretch">
        <div class="flex flex-col items-center pt-1">
          <span class="h-7 w-7 rounded-md flex items-center justify-center font-mono text-[11px]" style={`background: color-mix(in srgb, ${l.color} 18%, transparent); color: ${l.color}; border: 1px solid color-mix(in srgb, ${l.color} 45%, transparent);`}>
            {String(i + 1).padStart(2, '0')}
          </span>
          {i < layers.length - 1 && <span class="flex-1 w-px mt-1" style="background: var(--border);"></span>}
        </div>
        <div class="card p-4 mb-1" style={`border-left: 3px solid ${l.color};`}>
          <div class="flex items-center justify-between gap-3 mb-1">
            <h3 class="font-medium text-[15px]">{l.name}</h3>
            <span class="font-mono text-[10px] uppercase tracking-wider text-muted">{l.stage}</span>
          </div>
          <p class="text-sm text-muted leading-relaxed">{l.desc}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
