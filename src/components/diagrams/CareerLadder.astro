---
const steps = [
  { name: 'PAT', color: '#86efac' },
  { name: 'Builder Pairing', color: '#7cc4ff' },
  { name: 'Builder', color: '#67e8f9' },
  { name: 'Reviewer', color: '#fbbf24' },
  { name: 'Architect', color: '#b794f4' },
];
---

<div class="card p-6 md:p-8">
  <div class="mb-6">
    <div class="eyebrow mb-1">The GI Career Ladder</div>
    <div class="text-sm text-muted">Semantic apprenticeship replaces repetitive implementation as the path to mastery.</div>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    {steps.map((s, i) => (
      <Fragment>
        <div class="card px-4 py-3 flex-1 min-w-[140px] text-center" style={`border-top: 2px solid ${s.color};`}>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted">Stage {i + 1}</div>
          <div class="text-sm font-medium mt-0.5">{s.name}</div>
        </div>
        {i < steps.length - 1 && <span class="text-muted font-mono text-lg select-none">→</span>}
      </Fragment>
    ))}
  </div>
</div>
