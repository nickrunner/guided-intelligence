---
import { sectionLinks, utilityLinks } from '../data/nav';
import Logo from './Logo.astro';
const { current } = Astro.props as { current?: string };
---

<header class="sticky top-0 z-40 backdrop-blur-md" style="background: color-mix(in srgb, var(--bg) 80%, transparent); border-bottom: 1px solid var(--border);">
  <div class="container-full flex h-14 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 group">
      <Logo size={26} withWordmark />
    </a>

    <nav class="hidden lg:flex items-center gap-1 text-sm">
      {sectionLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-2.5 py-1.5 rounded-md transition-colors',
            current === link.href ? 'text-[color:var(--fg)] bg-elev' : 'text-muted hover:text-[color:var(--fg)]',
          ]}
        >
          {link.short ?? link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/glossary" class="hidden md:inline-flex btn btn-ghost text-xs px-3 py-1.5">Glossary</a>
      <a href="/whitepaper" class="btn btn-primary text-xs px-3 py-1.5">Read paper</a>
      <button
        id="theme-toggle"
        aria-label="Toggle theme"
        class="hidden md:inline-flex h-8 w-8 items-center justify-center rounded-md border-subtle border"
      >
        <svg id="theme-icon-sun" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg id="theme-icon-moon" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button
        id="mobile-nav-toggle"
        aria-label="Open menu"
        class="lg:hidden h-8 w-8 inline-flex items-center justify-center rounded-md border-subtle border"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden lg:hidden border-t border-subtle">
    <div class="container-full py-4 grid grid-cols-2 gap-1 text-sm">
      {[...sectionLinks, ...utilityLinks].map((link) => (
        <a href={link.href} class="px-3 py-2 rounded-md text-muted hover:text-[color:var(--fg)] hover:bg-elev">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const stored = localStorage.getItem('gi-theme');
    if (stored === 'light') root.classList.add('light');
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    function syncIcons() {
      const isLight = root.classList.contains('light');
      if (sun) sun.classList.toggle('hidden', !isLight);
      if (moon) moon.classList.toggle('hidden', isLight);
    }
    syncIcons();
    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', () => {
        root.classList.toggle('light');
        localStorage.setItem('gi-theme', root.classList.contains('light') ? 'light' : 'dark');
        syncIcons();
      });
    }
    const mobileBtn = document.getElementById('mobile-nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    if (mobileBtn && mobileNav) {
      mobileBtn.addEventListener('click', () => mobileNav.classList.toggle('hidden'));
    }
  })();
</script>
