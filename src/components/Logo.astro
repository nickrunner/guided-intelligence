---
interface Props {
  size?: number;
  class?: string;
  withWordmark?: boolean;
}
const { size = 24, class: className = '', withWordmark = false } = Astro.props;
const gradId = `gi-logo-grad-${Math.random().toString(36).slice(2, 8)}`;
---

{withWordmark ? (
  <span class={`inline-flex items-center gap-2.5 ${className}`}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      width={size}
      height={size}
      aria-hidden="true"
      class="shrink-0 rounded-[20%]"
    >
      <defs>
        <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#7cc4ff"/>
          <stop offset="100%" stop-color="#b794f4"/>
        </linearGradient>
      </defs>
      <rect x="3" y="3" width="26" height="26" rx="6" fill={`url(#${gradId})`}/>
      <path
        d="M 17 11 L 11 11 A 3 3 0 0 0 8 14 L 8 18 A 3 3 0 0 0 11 21 L 17 21 L 17 16.5 L 13.5 16.5"
        stroke="#0b0d10"
        stroke-width="2.6"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="23" cy="12" r="1.6" fill="#0b0d10"/>
      <circle cx="23" cy="16" r="1.6" fill="#0b0d10"/>
      <circle cx="23" cy="20" r="1.6" fill="#0b0d10"/>
    </svg>
    <span class="font-semibold tracking-tight text-[15px]">Guided Intelligence</span>
  </span>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
    width={size}
    height={size}
    aria-label="Guided Intelligence"
    class={`shrink-0 rounded-[20%] ${className}`}
  >
    <defs>
      <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#7cc4ff"/>
        <stop offset="100%" stop-color="#b794f4"/>
      </linearGradient>
    </defs>
    <rect x="3" y="3" width="26" height="26" rx="6" fill={`url(#${gradId})`}/>
    <path
      d="M 17 11 L 11 11 A 3 3 0 0 0 8 14 L 8 18 A 3 3 0 0 0 11 21 L 17 21 L 17 16.5 L 13.5 16.5"
      stroke="#0b0d10"
      stroke-width="2.6"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="23" cy="12" r="1.6" fill="#0b0d10"/>
    <circle cx="23" cy="16" r="1.6" fill="#0b0d10"/>
    <circle cx="23" cy="20" r="1.6" fill="#0b0d10"/>
  </svg>
)}
