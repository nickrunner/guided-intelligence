---
import { getPrevNext } from '../data/nav';
const { current } = Astro.props as { current: string };
const { prev, next } = getPrevNext(current);
---

<nav class="mt-20 border-t border-subtle pt-8 grid gap-4 md:grid-cols-2">
  {prev ? (
    <a href={prev.href} class="card p-5 group hover:border-[color:var(--accent)] transition-colors">
      <div class="eyebrow mb-1">← Previous · {prev.section}</div>
      <div class="text-lg font-medium">{prev.label}</div>
    </a>
  ) : <div></div>}
  {next ? (
    <a href={next.href} class="card p-5 group hover:border-[color:var(--accent)] md:text-right transition-colors">
      <div class="eyebrow mb-1">Next · {next.section} →</div>
      <div class="text-lg font-medium">{next.label}</div>
    </a>
  ) : <div></div>}
</nav>
