---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="relative overflow-hidden border-b border-subtle">
  <div class="absolute inset-0 opacity-[0.18] pointer-events-none grid-pattern" aria-hidden="true"></div>
  <div class="container-wide relative py-20 md:py-28">
    <div class="eyebrow mb-4">{eyebrow}</div>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight max-w-3xl text-gradient">{title}</h1>
    {lede && <p class="mt-5 text-lg md:text-xl text-muted max-w-2xl leading-relaxed">{lede}</p>}
  </div>
</section>
