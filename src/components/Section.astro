---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  width?: 'wide' | 'full' | 'prose';
  pad?: 'sm' | 'md' | 'lg';
}
const { id, eyebrow, title, lede, width = 'wide', pad = 'lg' } = Astro.props;
const widthClass = width === 'prose' ? 'container-prose' : width === 'full' ? 'container-full' : 'container-wide';
const padClass = pad === 'sm' ? 'py-10' : pad === 'md' ? 'py-16' : 'py-20';
---

<section id={id} class={`${widthClass} ${padClass}`}>
  {eyebrow && <div class="eyebrow mb-3">{eyebrow}</div>}
  {title && <h2 class="text-3xl md:text-4xl font-semibold tracking-tight max-w-3xl">{title}</h2>}
  {lede && <p class="mt-4 text-lg text-muted max-w-2xl leading-relaxed">{lede}</p>}
  <div class={title || eyebrow || lede ? 'mt-10' : ''}>
    <slot />
  </div>
</section>
