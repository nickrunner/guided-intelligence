---
import { sectionLinks } from '../data/nav';
import Logo from './Logo.astro';
---

<footer class="mt-32 border-t border-subtle">
  <div class="container-full py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <Logo size={26} withWordmark />
      <p class="mt-3 text-sm text-muted max-w-md">
        A Human-in-the-Loop, AI-Native engineering operating model aimed at achieving 10× velocity with stability.
      </p>
    </div>

    <div>
      <div class="eyebrow mb-3">Sections</div>
      <ul class="space-y-1.5 text-sm">
        {sectionLinks.map((l) => (
          <li><a href={l.href} class="text-muted hover:text-[color:var(--fg)]">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <div class="eyebrow mb-3">Resources</div>
      <ul class="space-y-1.5 text-sm">
        <li><a href="/glossary" class="text-muted hover:text-[color:var(--fg)]">Glossary</a></li>
        <li><a href="/whitepaper" class="text-muted hover:text-[color:var(--fg)]">Full whitepaper</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-subtle">
    <div class="container-full py-5 text-xs text-muted flex flex-col md:flex-row gap-2 md:items-center md:justify-between">
      <span>© {new Date().getFullYear()} Guided Intelligence Whitepaper.</span>
      <span class="font-mono">Velocity with stability · Semantics with automation · Human judgment at the center.</span>
    </div>
  </div>
</footer>
