---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import TeamComposition from '../components/diagrams/TeamComposition.astro';

const transitionSteps = [
  {
    no: '1',
    title: 'Replace multi-person code review with a single semantic gate',
    body: 'The Reviewer becomes the sole human approver.',
    color: '#fbbf24',
  },
  {
    no: '2',
    title: 'Move decomposition into the Execution Plan',
    body: 'Planner + AI generate the plan; Builders no longer break tasks manually.',
    color: '#b794f4',
  },
  {
    no: '3',
    title: 'Replace QA gating with PAT + ring deployments',
    body: 'Releases become continuous; QA becomes a system-level function.',
    color: '#86efac',
  },
];

const phases = [
  { no: '0', title: 'Define Domains', body: 'Assign Architects. Establish invariants, boundaries, and contracts.' },
  { no: '1', title: 'Introduce roles', body: 'Planner / Builder / Reviewer. Reassign responsibilities and adopt Execution Plans.' },
  { no: '2', title: 'Adopt Ring Deployments', body: 'Eliminate release windows and sprint hardening phases.' },
  { no: '3', title: 'Shift QA to PAT', body: 'PAT becomes continuous system validation, not gating.' },
  { no: '4', title: 'Scale semantic oversight', body: 'Increase Reviewer capacity, refine AI agents, expand invariant coverage.' },
];

const tooling = [
  { area: 'Agentic AI', items: ['Planning + execution agents', 'Execution Plan templates'] },
  { area: 'CI / CD', items: ['Tests + invariant enforcement', 'Automated ring deployment'] },
  { area: 'Observability', items: ['Logs · metrics · tracing', 'Anomaly detection'] },
  { area: 'PAT operations', items: ['Regression suite tools', 'Exploratory test harness'] },
  { area: 'Review surface', items: ['Lightweight semantic review UI', 'Cross-contract diff analyzers'] },
  { area: 'Safety', items: ['Domain invariant frameworks', 'Auto-rollback tooling'] },
];

const failureModes = [
  'Shared domain ownership (ambiguity)',
  'Multi-domain PRs (coupling)',
  'PAT operating as a release gate (batching)',
  'Builder scope creep (semantic drift)',
  'Reviewer bottlenecks (insufficient throughput)',
  'Sprint ceremonies as "training wheels"',
  'Planner/Builder/Reviewer role bleed',
];

const cultural = [
  'Semantic clarity is the new bottleneck',
  'Batching destroys velocity',
  'Role boundaries prevent ambiguity',
  'Review throughput is the gating function',
  'PAT is continuous, not a release gate',
  'Architects own domains end-to-end',
  'AI handles mechanical work',
];
---

<BaseLayout
  title="Implementation Blueprint"
  current="/implementation"
  description="How to adopt Guided Intelligence: a phased blueprint for moving from sprint-based Agile to continuous, AI-native engineering."
>
  <SectionHero
    eyebrow="§8 · Implementation"
    title="GI is designed to be practical."
    lede="A blueprint for real engineering organizations moving from Agile/DevOps to GI: staffing, responsibilities, phased adoption, tooling, and common failure modes."
  />

  <section class="container-wide py-16">
    <div class="mb-8 max-w-2xl">
      <div class="eyebrow mb-3">§8.1 · Transition</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Three steps for immediate throughput.</h2>
      <p class="mt-3 text-muted leading-relaxed">
        These three structural changes raise throughput dramatically, even before any staffing adjustments.
      </p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {transitionSteps.map((s) => (
        <article class="card p-6 flex flex-col" style={`border-top: 3px solid ${s.color};`}>
          <div class="font-mono text-3xl font-semibold mb-3" style={`color: ${s.color}`}>{s.no}</div>
          <h3 class="text-lg font-semibold leading-snug">{s.title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{s.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-wide py-16">
    <div class="mb-8 max-w-2xl">
      <div class="eyebrow mb-3">§8.2–8.3 · Staffing</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Small teams, sharp roles.</h2>
      <p class="mt-3 text-muted leading-relaxed">
        Execution is cheap, semantic clarity is expensive. GI teams stay small on purpose and scale linearly across domains without coordination drag.
      </p>
    </div>
    <TeamComposition />
  </section>

  <section class="container-wide py-16">
    <div class="mb-8 max-w-2xl">
      <div class="eyebrow mb-3">§8.4 · Phased adoption</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Five phases, each with immediate gains.</h2>
    </div>
    <div class="card overflow-x-auto">
      <div class="grid grid-cols-[repeat(5,minmax(180px,1fr))] divide-x divide-[color:var(--border)]">
        {phases.map((p, i) => (
          <div class="p-5">
            <div class="font-mono text-[11px] uppercase tracking-wider text-muted">Phase {p.no}</div>
            <div class="mt-2 text-sm font-medium">{p.title}</div>
            <p class="mt-2 text-sm text-muted leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-wide py-16">
    <div class="mb-8 max-w-2xl">
      <div class="eyebrow mb-3">§8.5 · Tooling</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">What GI requires.</h2>
      <p class="mt-3 text-muted leading-relaxed">
        Tooling amplifies semantic capacity and minimizes mechanical overhead.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {tooling.map((t) => (
        <div class="card p-5">
          <div class="eyebrow mb-3">{t.area}</div>
          <ul class="space-y-1.5 text-sm">
            {t.items.map((i) => (
              <li class="flex gap-2"><span class="text-muted">·</span><span>{i}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide py-16">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="card p-7">
        <div class="eyebrow mb-3" style="color: #86efac;">§8.6 · Cultural prerequisites</div>
        <ul class="space-y-2 text-sm">
          {cultural.map((c) => (
            <li class="flex gap-2"><span style="color: #86efac;">→</span>{c}</li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted">Teams that resist these principles slide into "AI-assisted Agile," which is the worst of both worlds.</p>
      </div>
      <div class="card p-7" style="border-left: 3px solid #f87171;">
        <div class="eyebrow mb-3" style="color: #f87171;">§8.7 · Anti-patterns</div>
        <ul class="space-y-2 text-sm">
          {failureModes.map((f) => (
            <li class="flex gap-2"><span style="color: #f87171;">×</span>{f}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="container-wide pb-12">
    <PrevNextNav current="/implementation" />
  </div>
</BaseLayout>
