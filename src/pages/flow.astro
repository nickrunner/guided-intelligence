---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import FlowDiagram from '../components/diagrams/FlowDiagram.astro';
import BackflowPaths from '../components/diagrams/BackflowPaths.astro';

const forwardStages = [
  {
    title: 'Planner → Builder',
    rules: [
      'Nothing starts until the plan is approved.',
      'Builders work on exactly one Execution Plan at a time.',
      'Context switching is treated as a cost, not a tactic.',
    ],
    body: 'The Planner produces the Execution Plan: scope, constraints, invariants, integration surfaces, and risk notes. Once approved, the Builder begins execution.',
  },
  {
    title: 'Builder → Reviewer',
    rules: [
      'Builder verifies all mechanical correctness before review.',
      'Reviewer time is sacred: only semantic questions reach them.',
      'Small, clean, focused diffs are mandatory.',
    ],
    body: 'The Builder uses AI to execute the plan: code, tests, migrations, refactors, and invariant validation. They keep AI aligned and correct missteps early.',
  },
  {
    title: 'Reviewer → Merge',
    rules: [
      'Reviewer is the final semantic authority.',
      'Reviewer speed determines domain throughput.',
      'Reviewer rejects are treated as high-priority events.',
    ],
    body: 'The Reviewer checks intent alignment, invariant preservation, architectural correctness, domain boundary respect, and semantic coherence. If approved, the change merges and deploys to Ring 0 then Ring 1 automatically.',
  },
];

const blockers = [
  { name: 'Domain Internal', resolver: 'Planner', desc: 'Resolved within the domain by the Planner.' },
  { name: 'Cross-Domain Contract', resolver: 'Planner ↔ Planner', desc: 'Resolved between the respective domain Planners.' },
  { name: 'AI Execution Limitation', resolver: 'Builder or Planner', desc: 'Mitigated by Builder; escalated when constraints need to change.' },
  { name: 'Sev5 System Blocker', resolver: 'Stop the line', desc: 'Halts the entire domain until invariants are restored.' },
];

const reviewerPrinciples = [
  { n: '1', title: 'Time is the scarcest resource', body: 'Domain throughput depends on review capacity.' },
  { n: '2', title: 'Feedback stays semantic', body: 'No nitpicking syntax or style. AI handles that upstream.' },
  { n: '3', title: 'Rejects are system events', body: 'A reject signals semantic drift or a planning defect, not a typo.' },
  { n: '4', title: 'Authority is unambiguous', body: 'No democratic review. No multiple approvals. One Reviewer is enough.' },
];
---

<BaseLayout
  title="The GI Flow"
  current="/flow"
  description="From intent to production, one Execution Plan at a time — continuous, single-threaded, with PAT validating the running system in the background."
>
  <SectionHero
    eyebrow="§4 · The GI Flow"
    title="A single-threaded, domain-aligned pipeline."
    lede="The forward flow is the default. Backflow is allowed but tightly controlled. Parallelization is discouraged by design. GI is depth-first, not breadth-first."
  />

  <section class="container-wide py-16">
    <div class="mb-8">
      <div class="eyebrow mb-3">§4.1 · The forward flow</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Intent in, production out, continuously.</h2>
    </div>
    <FlowDiagram />

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {forwardStages.map((s, i) => (
        <article class="card p-6 flex flex-col">
          <div class="font-mono text-[11px] text-[color:var(--accent)] mb-3">Stage {i + 1}</div>
          <h3 class="text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{s.body}</p>
          <div class="mt-5 pt-5 border-t border-subtle">
            <div class="eyebrow text-[10px] mb-2">Rules</div>
            <ol class="space-y-1.5 text-sm">
              {s.rules.map((r, j) => (
                <li class="flex gap-2"><span class="font-mono text-muted text-xs pt-0.5">{j + 1}.</span><span>{r}</span></li>
              ))}
            </ol>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container-wide py-16">
    <div class="mb-8 max-w-2xl">
      <div class="eyebrow mb-3">§4.2 · Reviewer as regulator</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Reviewers give GI its structural coherence.</h2>
      <p class="mt-3 text-muted leading-relaxed">
        Their decisions control whether work proceeds, whether backflow occurs, whether the domain stops, and whether the system stays coherent.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {reviewerPrinciples.map((p) => (
        <div class="card p-5">
          <div class="font-mono text-2xl font-semibold" style="color: var(--accent);">{p.n}</div>
          <div class="text-sm font-medium mt-2">{p.title}</div>
          <p class="mt-1.5 text-sm text-muted leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide py-16">
    <div class="mb-8 max-w-2xl">
      <div class="eyebrow mb-3">§4.3 · Backflow</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Three strict paths when forward flow breaks.</h2>
      <p class="mt-3 text-muted leading-relaxed">
        Each path has rules designed to minimize chaos and keep the pipeline depth-first.
      </p>
    </div>
    <BackflowPaths />
  </section>

  <section class="container-wide py-16">
    <div class="mb-8 max-w-2xl">
      <div class="eyebrow mb-3">§4.4 · Blockers</div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Four blocker types. Four resolution paths.</h2>
    </div>
    <div class="card overflow-hidden">
      <div class="grid grid-cols-[1.4fr_1.4fr_2fr] border-b border-subtle bg-elev font-mono text-[10px] uppercase tracking-wider text-muted">
        <div class="px-5 py-3">Type</div>
        <div class="px-5 py-3 border-l border-subtle">Resolver</div>
        <div class="px-5 py-3 border-l border-subtle">Description</div>
      </div>
      {blockers.map((b, i) => (
        <div class:list={['grid grid-cols-[1.4fr_1.4fr_2fr] text-sm', i < blockers.length - 1 && 'border-b border-subtle']}>
          <div class="px-5 py-3.5 font-medium">{b.name}</div>
          <div class="px-5 py-3.5 border-l border-subtle text-[color:var(--accent)] font-mono text-[12px]">{b.resolver}</div>
          <div class="px-5 py-3.5 border-l border-subtle text-muted">{b.desc}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide py-16">
    <div class="card p-8 md:p-10 max-w-3xl">
      <div class="eyebrow mb-3">§4.5 · Parallelization</div>
      <p class="text-lg md:text-xl leading-relaxed">
        Builders work one plan at a time. Planners focus on one semantic framing at a time. Reviewers handle one review at a time. Backflow is resolved <span class="text-[color:var(--accent)]">before</span> new forward work begins.
      </p>
      <p class="mt-4 text-muted text-sm leading-relaxed">
        Parallelization under AI acceleration creates thrash, ambiguity, and compounding semantic errors. GI is depth-first by design.
      </p>
    </div>
  </section>

  <div class="container-wide pb-12">
    <PrevNextNav current="/flow" />
  </div>
</BaseLayout>
